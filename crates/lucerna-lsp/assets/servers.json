{
  "rust-analyzer": {
    "command": "rust-analyzer",
    "languages": [
      "rust"
    ],
    "root_markers": [
      "Cargo.toml"
    ],
    "root_search": "outermost",
    "install": "rustup component add rust-analyzer",
    "homepage": "https://rust-analyzer.github.io/book/installation.html"
  },
  "gopls": {
    "command": "gopls",
    "languages": [
      "go"
    ],
    "root_markers": [
      "go.work",
      "go.mod"
    ],
    "root_search": "ordered",
    "probe": [
      "version"
    ],
    "install": "go install golang.org/x/tools/gopls@latest",
    "homepage": "https://go.dev/gopls/"
  },
  "basedpyright": {
