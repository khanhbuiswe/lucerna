{
  "editor.fontFamily": "Lilex",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.tabSize": 4,
  "editor.cursorSurroundingLines": 0,
  "editor.cursorBlinking": "blink",
  "editor.cursorStyle": "line",
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  "editor.emptySelectionClipboard": true,
  "files.exclude": { "**/.git": true, "**/.DS_Store": true },
  "files.eol": "auto",
  "files.encoding": "utf8",
  "files.insertFinalNewline": false,
  "files.trimFinalNewlines": false,
  "files.trimTrailingWhitespace": false,
  "files.saveConflictResolution": "askUser",
  "search.exclude": { "**/node_modules": true, "**/target": true },
  "search.searchEditor.defaultNumberOfContextLines": 1,
  "workbench.colorTheme": "One Dark",
  "workbench.iconTheme": "Lucide",
  "files.associations": {},
  "extensions.autoCheckUpdates": true,
  "workbench.editor.enablePreview": true,
  "explorer.autoReveal": true,
  "explorer.decorations.externalChanges": true,
  "lucerna.largeFile.maxBytes": 20971520,
  "lucerna.largeFile.maxLines": 300000,
  "vim.ignorecase": true,
  "vim.wrapscan": true,
  "vim.startofline": true,
  "vim.scroll": 0,
  "lucerna.lsp.enabled": true,
  "lucerna.lsp.languageServers": ["..."],
  "[python]": { "lucerna.lsp.languageServers": ["basedpyright", "!pyright", "..."] },
  "lsp": {},
  "session.trustAllWorktrees": false,
  "editor.hover.enabled": true,
  "editor.hover.delay": 300,
  "editor.hover.sticky": true,
  "editor.hover.hidingDelay": 300,
  "editor.gotoLocation.multipleDefinitions": "peek",
  "editor.gotoLocation.multipleTypeDefinitions": "peek",
  "editor.gotoLocation.multipleImplementations": "peek",
  "editor.gotoLocation.multipleDeclarations": "peek",
  "editor.gotoLocation.multipleReferences": "peek",
  "lucerna.diagnostics.gutterIcons": true,
  "lucerna.diagnostics.inline.enabled": false,
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",
  "breadcrumbs.icons": true
}
