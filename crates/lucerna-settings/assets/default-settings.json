{
  "explorer.confirmDelete": true,
  "explorer.copyRelativePathSeparator": "auto",
  "terminal.external.osxExec": "Terminal.app",
  "terminal.external.linuxExec": "x-terminal-emulator",
  "terminal.external.windowsExec": "cmd.exe",
  "editor.fontFamily": "Lilex",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": false,
  "editor.scrollbar.scrollByPage": false,
  "editor.renderWhitespace": "none",
  "editor.tabSize": 4,
  "editor.cursorSurroundingLines": 0,
  "editor.cursorBlinking": "blink",
  "editor.cursorStyle": "line",
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  "editor.emptySelectionClipboard": true,
  "editor.autoIndent": "full",
  "editor.detectIndentation": true,
  "editor.autoClosingBrackets": "languageDefined",
  "editor.autoClosingQuotes": "languageDefined",
  "editor.autoClosingOvertype": "auto",
  "editor.autoClosingDelete": "auto",
  "editor.autoSurround": "languageDefined",
  "files.exclude": { "**/.git": true, "**/.DS_Store": true },
  "files.eol": "auto",
  "files.encoding": "utf8",
  "files.insertFinalNewline": false,
  "files.trimFinalNewlines": false,
  "files.trimTrailingWhitespace": false,
  "files.autoSave": "off",
  "files.autoSaveDelay": 1000,
  "files.saveConflictResolution": "askUser",
  "lucerna.externalChanges.autoMerge": true,
  "search.exclude": { "**/node_modules": true, "**/target": true },
  "search.searchEditor.defaultNumberOfContextLines": 1,
  // If enabled, automatically select a color theme based on the system color mode:
  // `workbench.preferredDarkColorTheme` when it is dark, `workbench.preferredLightColorTheme` when it is light.
  "window.autoDetectColorScheme": true,
  // The color theme used when `window.autoDetectColorScheme` is disabled.
  "workbench.colorTheme": "Lucerna Dark",
  // The color theme used when the system color mode is dark and `window.autoDetectColorScheme` is enabled.
  "workbench.preferredDarkColorTheme": "Lucerna Dark",
  // The color theme used when the system color mode is light and `window.autoDetectColorScheme` is enabled.
  "workbench.preferredLightColorTheme": "Lucerna Light",
  "workbench.iconTheme": "Lucide",
  // Controls which editor is shown at startup, if none are restored from the previous session.
  // "welcomePage" | "welcomePageInEmptyWorkbench": the Welcome screen when Lucerna starts without a folder.
  // "none": ask for a folder instead; Cancel quits.
  "workbench.startupEditor": "welcomePage",
  "workbench.tips.enabled": true,
  "files.associations": {},
  "extensions.autoCheckUpdates": true,
  "workbench.editor.enablePreview": true,
  "explorer.autoReveal": true,
  "explorer.decorations.externalChanges": true,
  "lucerna.largeFile.maxBytes": 20971520,
  "lucerna.largeFile.maxLines": 300000,
  "vim.ignorecase": true,
  "vim.wrapscan": true,
  "vim.startofline": true,
  "vim.scroll": 0,
  "vim.useSystemClipboard": "onYank",
  "vim.joinspaces": true,
  "vim.changeWordIncludesWhitespace": false,
  "vim.tildeop": false,
  "lucerna.lsp.enabled": true,
  "lucerna.lsp.languageServers": ["..."],
  "[python]": { "lucerna.lsp.languageServers": ["basedpyright", "!pyright", "..."] },
  "lsp": {},
  "session.trustAllWorktrees": false,
  "editor.hover.enabled": true,
  "editor.hover.delay": 300,
  "editor.hover.sticky": true,
  "editor.hover.hidingDelay": 300,
  "editor.gotoLocation.multipleDefinitions": "peek",
  "editor.gotoLocation.multipleTypeDefinitions": "peek",
  "editor.gotoLocation.multipleImplementations": "peek",
  "editor.gotoLocation.multipleDeclarations": "peek",
  "editor.gotoLocation.multipleReferences": "peek",
  "lucerna.diagnostics.gutterIcons": true,
  "lucerna.diagnostics.inline.enabled": false,
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",
  "breadcrumbs.icons": true,
  "markdown.preview.fontSize": 14,
  "markdown.preview.lineHeight": 1.6,
  "markdown.preview.fontFamily": "",
  "markdown.preview.scrollPreviewWithEditor": true,
  "markdown.preview.scrollEditorWithPreview": true,
  "markdown.preview.doubleClickToSwitchToEditor": true,
  // Where a link to another Markdown file opens: "inPreview" or "inEditor".
  "markdown.preview.openMarkdownLinks": "inPreview",
  // Which editor opens a file, by glob. A glob without "/" matches the file name; one with "/"
  // matches the root-relative path, else the absolute path (such as "/notes/**/*.md").
  // "vscode.markdown.preview.editor": the Markdown preview. "default": the source.
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor",
    "*.markdown": "vscode.markdown.preview.editor"
  }
}
