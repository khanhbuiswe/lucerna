{
  "editor.fontFamily": "Lilex",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.tabSize": 4,
  "editor.cursorSurroundingLines": 0,
  "editor.cursorBlinking": "blink",
  "editor.cursorStyle": "line",
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  "editor.emptySelectionClipboard": true,
  "editor.autoIndent": "full",
  "editor.detectIndentation": true,
  "editor.autoClosingBrackets": "languageDefined",
  "editor.autoClosingQuotes": "languageDefined",
  "editor.autoClosingOvertype": "auto",
  "editor.autoClosingDelete": "auto",
  "editor.autoSurround": "languageDefined",
  "files.exclude": { "**/.git": true, "**/.DS_Store": true },
  "files.eol": "auto",
  "files.encoding": "utf8",
  "files.insertFinalNewline": false,
  "files.trimFinalNewlines": false,
  "files.trimTrailingWhitespace": false,
  "files.autoSave": "off",
  "files.autoSaveDelay": 1000,
  "files.saveConflictResolution": "askUser",
  "lucerna.externalChanges.autoMerge": true,
  "search.exclude": { "**/node_modules": true, "**/target": true },
  "search.searchEditor.defaultNumberOfContextLines": 1,
  "workbench.colorTheme": "One Dark",
  "workbench.iconTheme": "Lucide",
  // Controls which editor is shown at startup, if none are restored from the previous session.
  // "welcomePage" | "welcomePageInEmptyWorkbench": the Welcome screen when Lucerna starts without a folder.
  // "none": ask for a folder instead; Cancel quits.
  "workbench.startupEditor": "welcomePage",
  "workbench.tips.enabled": true,
  "files.associations": {},
  "extensions.autoCheckUpdates": true,
  "workbench.editor.enablePreview": true,
  // Where the panel (the terminal) opens: "bottom" (under the editor area) or "right".
  "workbench.panel.defaultLocation": "bottom",
  // The integrated terminal (VS Code's keys and defaults, except where noted).
  // Empty font family and null font size: the editor's.
  "terminal.integrated.fontFamily": "",
  "terminal.integrated.fontSize": null,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.fontWeightBold": "bold",
  "terminal.integrated.drawBoldTextInBrightColors": true,
  "terminal.integrated.minimumContrastRatio": 4.5,
  // "block" | "line" | "underline"; apps may still set their own.
  "terminal.integrated.cursorStyle": "block",
  // While the terminal is not focused: "outline" | "block" | "line" | "underline" | "none".
  "terminal.integrated.cursorStyleInactive": "outline",
  "terminal.integrated.cursorBlinking": false,
  // A name from `profiles.<os>` ({ "path", "args", "env" }); null: $SHELL.
  "terminal.integrated.defaultProfile.osx": null,
  "terminal.integrated.defaultProfile.linux": null,
  "terminal.integrated.defaultProfile.windows": null,
  "terminal.integrated.profiles.osx": {},
  "terminal.integrated.profiles.linux": {},
  "terminal.integrated.profiles.windows": {},
  // Absolute, or relative to the workspace folder; empty: the workspace folder.
  "terminal.integrated.cwd": "",
  // Added to the environment; null removes a variable.
  "terminal.integrated.env.osx": {},
  "terminal.integrated.env.linux": {},
  "terminal.integrated.env.windows": {},
  // "auto": LANG=en_US.UTF-8 when LANG is unset or not UTF-8. "off" leaves it.
  "terminal.integrated.detectLocale": "auto",
  // At most 100000.
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.copyOnSelection": false,
  // "selectWord" | "copyPaste" | "paste" | "nothing" | "default" (as selectWord).
  "terminal.integrated.rightClickBehavior": "selectWord",
  "terminal.integrated.macOptionIsMeta": false,
  "terminal.integrated.macOptionClickForcesSelection": false,
  "terminal.integrated.mouseWheelScrollSensitivity": 1,
  "terminal.integrated.fastScrollSensitivity": 5,
  // "auto" (unless the app takes bracketed paste) | "always" | "never".
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.integrated.wordSeparators": " ()[]{}',\"`─‘’“”|",
  "terminal.integrated.enableFileLinks": "on",
  "terminal.integrated.allowedLinkSchemes": ["file", "http", "https", "mailto"],
  // Command IDs that skip the shell, on top of the defaults; "-id" removes one.
  "terminal.integrated.commandsToSkipShell": [],
  "terminal.integrated.allowChords": true,
  // "never" | "always" | "hasChildProcesses": ask before quitting or closing the window.
  "terminal.integrated.confirmOnExit": "never",
  "terminal.integrated.hideOnLastClosed": true,
  // Colours a tab that rang its bell until a key is typed in it.
  "terminal.integrated.enableBell": false,
  "explorer.autoReveal": true,
  "explorer.decorations.externalChanges": true,
  "lucerna.largeFile.maxBytes": 20971520,
  "lucerna.largeFile.maxLines": 300000,
  "vim.ignorecase": true,
  "vim.wrapscan": true,
  "vim.startofline": true,
  "vim.scroll": 0,
  "vim.useSystemClipboard": "onYank",
  "vim.joinspaces": true,
  "vim.changeWordIncludesWhitespace": false,
  "vim.tildeop": false,
  "lucerna.lsp.enabled": true,
  "lucerna.lsp.languageServers": ["..."],
  "[python]": { "lucerna.lsp.languageServers": ["basedpyright", "!pyright", "..."] },
  "lsp": {},
  "session.trustAllWorktrees": false,
  "editor.hover.enabled": true,
  "editor.hover.delay": 300,
  "editor.hover.sticky": true,
  "editor.hover.hidingDelay": 300,
  "editor.gotoLocation.multipleDefinitions": "peek",
  "editor.gotoLocation.multipleTypeDefinitions": "peek",
  "editor.gotoLocation.multipleImplementations": "peek",
  "editor.gotoLocation.multipleDeclarations": "peek",
  "editor.gotoLocation.multipleReferences": "peek",
  "lucerna.diagnostics.gutterIcons": true,
  "lucerna.diagnostics.inline.enabled": false,
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",
  "breadcrumbs.icons": true
}
